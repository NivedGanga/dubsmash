# Copy to .env.local for local development. In production set these in the Vercel dashboard.
# Variables prefixed NEXT_PUBLIC_ are exposed to the browser; everything else is server-only.

# ---------- App ----------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Comma-separated list of origins allowed to call the API cross-origin (same-origin is always allowed).
ALLOWED_ORIGINS=http://localhost:3000

# ---------- Supabase (Postgres + Realtime) ----------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------- Firebase Auth (client SDK) ----------
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000
# Comma-separated SSO providers to show on the login page: google,github (discord needs an OIDC provider id, see README)
NEXT_PUBLIC_FIREBASE_SSO_PROVIDERS=google,github
# Optional: Firebase OIDC provider id for Discord (e.g. oidc.discord)
NEXT_PUBLIC_FIREBASE_DISCORD_PROVIDER_ID=

# ---------- Firebase Admin (server token verification) ----------
# Service-account JSON, as a single line. Alternatively set the three FIREBASE_* vars below.
FIREBASE_CONFIG=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the literal \n sequences; they are converted to newlines at runtime.
FIREBASE_PRIVATE_KEY=

# ---------- Cloudinary ----------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
# Root folder inside Cloudinary for all assets
CLOUDINARY_ROOT_FOLDER=dubsmash

# ---------- SendGrid (only used when email_notifications_enabled flag is on) ----------
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@example.com

# ---------- Video processing worker / webhooks ----------
# Shared secret used by the FFmpeg worker (GitHub Actions) when calling /api/webhooks/ffmpeg-complete
WORKER_WEBHOOK_SECRET=change-me-to-a-long-random-string
